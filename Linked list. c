struct node *revlist(struct node *head)
{
    struct node *newnode,*rhead,*temp;
    temp=head;
    rhead=getnode();
    rhead->data=temp->data;
    newnode=getnode();
    while(temp->next!=NULL)
    {
        temp=temp->next;
        newnode->data=temp->data;
        newnode->next=rhead;
        rhead=newnode;
        newnode=getnode();
    }
    return head;
}
